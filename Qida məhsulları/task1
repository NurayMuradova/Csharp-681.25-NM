using System;
using System.Collections.Generic;
using System.Linq;

class Product
{
        private string name;
            private string category;
                private double price;
                    private DateTime expireDate;

                        public Product(string name, string category, double price, DateTime expireDate)
                            {
                                        this.name = name;
                                                this.category = category;
                                                        this.price = price;
                                                                this.expireDate = expireDate;
                            }

                                public string GetName() => name;
                                    public void SetName(string name) => this.name = name;

                                        public string GetCategory() => category;
                                            public void SetCategory(string category) => this.category = category;

                                                public double GetPrice() => price;
                                                    public void SetPrice(double price) => this.price = price;

                                                        public DateTime GetExpireDate() => expireDate;
                                                            public void SetExpireDate(DateTime expireDate) => this.expireDate = expireDate;

                                                                public void GetData()
                                                                    {
                                                                                Console.WriteLine($"Ad: {name}");
                                                                                        Console.WriteLine($"Kateqoriya: {category}");
                                                                                                Console.WriteLine($"Qiymet: {price}");
                                                                                                        Console.WriteLine($"Son tarix: {expireDate.ToShortDateString()}");
                                                                                                                Console.WriteLine("-------------------");
                                                                    }

                                                                        public bool IsExpired()
                                                                            {
                                                                                        return DateTime.Now > expireDate;
                                                                            }
}

